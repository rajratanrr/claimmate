# Guided mode is intentional. No AI key required or read.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Defaults to DATA_DIR/uploads if omitted:
# UPLOAD_DIR=/absolute/private/persistent-volume/uploads
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# On Render, RENDER_EXTERNAL_URL is automatically allowed. Set ALLOWED_ORIGINS
# only for extra exact origins, e.g. https://claimmate.example.com.
COOKIE_SECURE=false
# Set NODE_ENV=production when serving a completed build.
